{
  "manifest_version": 3,
  "name": "Format Forge — File Format Converter",
  "short_name": "Format Forge",
  "version": "0.1.0",
  "description": "Convert DOCX to PDF, PNG to JPG, MP4 to MP3, PDFs to images, and CSV to JSON. Private file conversion runs locally.",
  "action": {
    "default_title": "Open Format Forge File Converter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:43123/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' http://127.0.0.1:43123"
  }
}
