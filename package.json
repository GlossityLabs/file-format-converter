{
  "name": "format-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A privacy-first Chrome extension and local companion for converting documents, images, audio, and video.",
  "scripts": {
    "dev": "vite",
    "dev:companion": "tsx companion/server.ts",
    "companion:token": "tsx companion/token.ts",
    "smoke:companion": "node scripts/smoke-companion.mjs",
    "build": "npm run typecheck && vite build && npm run build:companion && npm run verify:build",
    "build:companion": "tsc -p tsconfig.companion.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.companion.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "npm run test && npm run build",
    "package:extension": "npm run build && node scripts/package-extension.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^1.24.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
